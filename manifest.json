{
  "manifest_version": 3,
  "name": "Leetcode AI Helper",
  "version": "1.1",
  "description": "AI-powered DSA hints for LeetCode problems using Google Gemini",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://*.leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}